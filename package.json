{
  "private": true,
  "type": "module",
  "scripts": {
    "test:contract": "ava ./tests/test.js --serial --timeout 30s",
    "contract:deploy": "cd contract && cargo near build non-reproducible-wasm && cd .. && node utils/deploy-contract.js",
    "contract:deploy:mac": "docker run --rm -it -v $(pwd):/code -w /code/contract rust:1.86.0 bash -c 'apt-get update && apt-get install -y clang llvm build-essential libudev-dev pkg-config && rustup target add wasm32-unknown-unknown && cargo install cargo-near && cargo near build non-reproducible-wasm' && node utils/deploy-contract.js",
    "contract:just-deploy": "node utils/deploy-contract.js",
    "dev": "next dev",
    "build": "next build",
    "tappd:run": "sudo docker run --rm -p 8090:8090 phalanetwork/tappd-simulator:latest",
    "port:kill": "sudo fuser -k 3000/tcp",
    "docker:build": "docker buildx build --platform linux/amd64 --no-cache --target prod -t ymc182/shade-agent:latest .",
    "docker:run": "sudo docker run --rm -p 3000:3000 ymc182/shade-agent:latest",
    "docker:image": "docker buildx build --platform linux/amd64 --no-cache --target prod -t ymc182/shade-agent:latest .",
    "docker:push": "docker push ymc182/shade-agent:latest",
    "docker:prune": "sudo docker system prune",
    "docker:restart": "sudo systemctl restart docker"
  },
  "dependencies": {
    "@ethereumjs/tx": "^5.3.0",
    "@ethereumjs/util": "^9.0.3",
    "@near-wallet-selector/coin98-wallet": "^9.0.3",
    "@near-wallet-selector/core": "^9.0.3",
    "@near-wallet-selector/default-wallets": "^8.1.4",
    "@near-wallet-selector/here-wallet": "^9.0.3",
    "@near-wallet-selector/ledger": "^9.0.3",
    "@near-wallet-selector/math-wallet": "^9.0.3",
    "@near-wallet-selector/meteor-wallet": "^9.0.3",
    "@near-wallet-selector/modal-ui": "^9.0.3",
    "@near-wallet-selector/my-near-wallet": "^9.0.3",
    "@near-wallet-selector/near-wallet": "^8.9.3",
    "@near-wallet-selector/nearfi": "^8.10.2",
    "@near-wallet-selector/nightly": "^9.0.3",
    "@near-wallet-selector/nightly-connect": "^8.7.0",
    "@near-wallet-selector/sender": "^9.0.3",
    "@near-wallet-selector/wallet-connect": "^9.0.3",
    "@neardefi/shade-agent-js": "^0.0.5",
    "@phala/dcap-qvl-web": "^0.1.0-beta.2",
    "@phala/dstack-sdk": "^0.1.7",
    "assert": "^2.1.0",
    "chainsig.js": "^1.1.6",
    "dotenv": "^16.4.7",
    "elliptic": "^6.5.5",
    "ethers": "^6.11.1",
    "https-browserify": "^1.0.0",
    "js-sha3": "^0.9.3",
    "near-api-js": "^5.0.1",
    "near-seed-phrase": "^0.2.1",
    "next": "latest",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "viem": "^2.28.1",
    "web3": "^4.6.0"
  },
  "devDependencies": {
    "@types/elliptic": "^6.4.18",
    "@types/node": "^20.11.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "^18.2.18",
    "ava": "^6.1.3",
    "next-transpile-modules": "^10.0.1",
    "typescript": "5.8.3"
  }
}
